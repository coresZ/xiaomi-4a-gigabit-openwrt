#!/bin/sh
# xray-sub: VLESS subscription + transparent proxy helper
D=/etc/xray
CH=$D/chain-history   # chain addresses used before, newest first; holds credentials, mode 600
cfg() { uci -q get xray.main.$1; }
mainpid() { ps | grep "[x]r -sub" | grep -v -- "-port 7893" | awk '{print $1}' | head -1; }
# when memory runs out the kernel must sacrifice a test instance (chain test), never the proxy that devices use
protect() { MP=$(mainpid); [ -n "$MP" ] && echo -800 > /proc/$MP/oom_score_adj 2>/dev/null; }
rules_off() { nft delete table ip xray 2>/dev/null; nft delete table ip6 xray6 2>/dev/null; }
TAB=$(printf '\t')
HD=/tmp/xray.h            # health state, one tiny file per value (RAM only)
ALIAS=/etc/netmon-alias.tsv
# the node_name stored in uci is a regular expression: same escaping as the web page uses
esc_re() { sed 's/[].*+?^${}()|[\\]/\\&/g'; }
# "81ms" in a node name changes with every refresh of the subscription: match any number there
fuzzy_ms() { sed 's/[0-9][0-9]*ms/[0-9]+ms/g'; }
# a list of IPv4 addresses / CIDR blocks separated by blanks -> only the valid ones, joined with ", " (empty when none)
ip_elems() {
	printf '%s\n' "$1" | tr ' ' '\n' | awk '
		NF && $0 ~ /^([0-9]+\.){3}[0-9]+(\/[0-9]+)?$/ {
			split($0, p, "/"); split(p[1], o, "."); ok = 1
			for (i = 1; i <= 4; i++) if (o[i] + 0 > 255) ok = 0
			if (p[2] != "" && p[2] + 0 > 32) ok = 0
			if (ok) printf "%s%s", (n++ ? ", " : ""), $0
		}
		END { if (n) print "" }'
}

# The node list and statistics only depend on sub.txt, but computing them means starting xr, which has to unpack
# ~15 MB in RAM (slow, and several at once exhaust memory). So compute once, cache in /tmp, and let only one run at a time.
LC=/tmp/xray.list; SC=/tmp/xray.stats; LK=/tmp/xray.lock
# remember a chain address (duplicates dropped, 8 kept)
chain_remember() {
	[ -n "$1" ] || return 0
	touch $CH; chmod 600 $CH
	grep -vxF "$1" $CH > $CH.new 2>/dev/null || :
	{ echo "$1"; cat $CH.new; } | head -n 8 > $CH.tmp && mv $CH.tmp $CH
	rm -f $CH.new
}
cache_ok() { [ -s "$LC" ] && [ -s "$SC" ] && [ "$LC" -nt "$D/sub.txt" ]; }
ensure_cache() {
	cache_ok && return 0
	[ -s "$D/sub.txt" ] || return 1
	# rebuilding the cache starts xr, which needs ~15 MB it does not have when the router is already short
	avail=$(awk '/MemAvailable/{print $2}' /proc/meminfo)
	[ "${avail:-0}" -ge 14000 ] || return 1
	w=0
	while [ $w -lt 40 ]; do
		if mkdir "$LK" 2>/dev/null; then
			/usr/bin/xr -sub "$D/sub.txt" -list > "$LC.tmp" 2>/dev/null && /usr/bin/xr -sub "$D/sub.txt" -stats > "$SC.tmp" 2>/dev/null \
				&& mv "$SC.tmp" "$SC" && mv "$LC.tmp" "$LC"
			rmdir "$LK" 2>/dev/null
			return 0
		fi
		cache_ok && return 0
		sleep 1; w=$((w+1))
	done
	rmdir "$LK" 2>/dev/null   # a stuck lock: clear it so the next call can try again
	return 1
}
# ---- exceptions by domain: the router resolves each listed domain itself (a fresh lookup + what the devices resolved, from
# netmon's name map in RAM) and keeps the addresses in the "direct4" / "proxy4" sets. The last known addresses are kept in
# flash so they are there right after a reboot. Every 5 minutes (cron) the sets are brought up to date.
EXC_CACHE=$D/domain-ips.tsv
is_domain() { echo "$1" | grep -qE '^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]([a-z0-9-]*[a-z0-9])?$' && [ ${#1} -le 253 ]; }
norm_domain() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed 's/^\*\.//; s/^\.//; s/\.$//'; }
resolve_domains() {
	doms="$(cfg direct_domains) $(cfg proxy_domains)"
	if [ -z "$(echo $doms)" ]; then [ -f $EXC_CACHE ] && rm -f $EXC_CACHE; return 0; fi
	DM=/tmp/netmon/dnsmap.tsv; [ -f $DM ] || DM=/dev/null
	CA=$EXC_CACHE; [ -f $CA ] || CA=/dev/null
	{
		for d in $doms; do echo "W$TAB$d"; done
		for d in $doms; do nslookup "$d" 127.0.0.1 2>/dev/null | sed -n '/^Name/,$p' | grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | sed "s/^/N$TAB$d$TAB/"; done
	} > /tmp/xray.exc.in
	for d in $doms; do echo "$d"; done > /tmp/xray.exc.doms
	grep -F -f /tmp/xray.exc.doms $DM > /tmp/xray.exc.dm 2>/dev/null; rm -f /tmp/xray.exc.doms
	awk -F"$TAB" '
		function add(d, ip) {
			if (ip ~ /^(0|10|127)\./ || ip ~ /^192\.168\./ || ip ~ /^169\.254\./ || ip ~ /^172\.(1[6-9]|2[0-9]|3[01])\./ || ip ~ /^2(2[4-9]|[3-5][0-9])\./) return
			if (cnt[d] >= 120 || ((d SUBSEP ip) in has)) return
			has[d SUBSEP ip] = 1; cnt[d]++; ord[d] = ord[d] " " ip
		}
		FILENAME == ARGV[1] { if ($1 == "W") want[$2] = 1; else if ($1 == "N") add($2, $3); next }
		FILENAME == ARGV[2] { c = split($3, lb, "."); s = ""; for (k = c; k >= 1; k--) { s = (s == "" ? lb[k] : lb[k] "." s); if (s in want) add(s, $2) } next }
		FILENAME == ARGV[3] { if ($1 in want) { m = split($2, a, " "); for (i = 1; i <= m; i++) add($1, a[i]) } next }
		END { for (d in want) if (cnt[d]) print d "\t" substr(ord[d], 2) }' /tmp/xray.exc.in /tmp/xray.exc.dm $CA | sort > /tmp/xray.exc.out
	rm -f /tmp/xray.exc.in /tmp/xray.exc.dm
	# flash is only written when the answer really changed
	if [ -s /tmp/xray.exc.out ]; then
		{ [ -f $EXC_CACHE ] && cmp -s /tmp/xray.exc.out $EXC_CACHE; } || cp /tmp/xray.exc.out $EXC_CACHE
	fi
	rm -f /tmp/xray.exc.out
}
# "a, b, c": the addresses / blocks of one list plus the current addresses of its domains
exc_elems() {
	dips=$(awk -F"$TAB" -v list=" $(cfg ${1}_domains) " 'index(list, " " $1 " ") { print $2 }' $EXC_CACHE 2>/dev/null)
	ip_elems "$(cfg ${1}_ips) $dips"
}
# push the lists into the running rules without reloading them
exc_apply() {
	nft list set ip xray proxy4 >/dev/null 2>&1 || return 0
	for kind in proxy direct; do
		e=$(exc_elems $kind); sig=$(printf '%s' "$e" | md5sum | cut -d' ' -f1)
		[ "$sig" = "$(cat /tmp/xray.exc.$kind 2>/dev/null)" ] && continue
		nft flush set ip xray ${kind}4 2>/dev/null
		if [ -n "$e" ]; then nft add element ip xray ${kind}4 "{ $e }" || { echo "could not load the $kind list" >&2; continue; }; fi
		echo "$sig" > /tmp/xray.exc.$kind
	done
}

# ---- is the proxy path alive? Send a tiny HTTP request to a foreign IP from the router itself. A temporary output rule
# hands that one connection to the running proxy (no extra process, no download), so the whole chain is exercised.
probe_one() {
	nft delete table ip xhealth 2>/dev/null
	nft add table ip xhealth && nft add chain ip xhealth out '{ type nat hook output priority -100 ; }' \
		&& nft add rule ip xhealth out ip daddr $1 tcp dport 80 redirect to :"${2:-$(cfg port)}" || { nft delete table ip xhealth 2>/dev/null; return 1; }
	# the redirect always completes the TCP handshake with the local proxy, so only a real HTTP answer proves the whole path works
	r=$(wget -T 6 -O /dev/null "http://$1/" 2>&1); rc=$?
	nft delete table ip xhealth 2>/dev/null
	[ $rc = 0 ] && return 0
	# any answer from a website proves the path: a status error (403/500) or a redirect ("Failed to redirect") is as good as a 200
	case "$r" in *"HTTP error"*|*"Failed to redirect"*) return 0 ;; esac
	return 1
}
probe_proxy() { probe_one 104.16.0.1 "$1" || probe_one 151.101.1.69 "$1"; }
probe_wan() { ping -c 1 -W 2 223.5.5.5 >/dev/null 2>&1 || ping -c 1 -W 2 119.29.29.29 >/dev/null 2>&1; }
# the node to move to: the next one of the same source (text before the first "-"), else the next one of any source
pick_next() {
	ensure_cache; cur=$(cfg node_name); curprov=""; first=""; after=""; seen=0
	while IFS="$TAB" read i name kind; do
		[ -n "$name" ] || continue
		e="^$(printf '%s' "$name" | esc_re | fuzzy_ms)\$"
		if [ "$e" = "$cur" ]; then seen=1; curprov="${name%%-*}"; case "$name" in *-*) ;; *) curprov="" ;; esac; fi
	done < "$LC"
	seen2=0
	while IFS="$TAB" read i name kind; do
		[ -n "$name" ] || continue
		e="^$(printf '%s' "$name" | esc_re | fuzzy_ms)\$"
		if [ "$e" = "$cur" ]; then seen2=1; continue; fi
		if [ -n "$curprov" ]; then case "$name" in "$curprov"-*) ;; *) continue ;; esac; fi
		[ -n "$first" ] || first="$name"
		[ $seen2 = 1 ] && [ -z "$after" ] && after="$name"
	done < "$LC"
	[ -n "$after" ] && { echo "$after"; return 0; }
	[ -n "$first" ] && { echo "$first"; return 0; }
	return 1
}
failover() {
	now=$(date +%s); last=$(cat $HD/sw_ts 2>/dev/null || echo 0)
	[ $((now - last)) -ge 600 ] || return 0
	nn=$(pick_next) || return 0
	[ -n "$nn" ] || return 0
	if [ -n "$DRYRUN" ]; then echo "would switch to: $nn"; return 0; fi
	from=$(cfg node_name)
	uci set xray.main.node_name="^$(printf '%s' "$nn" | esc_re | fuzzy_ms)\$" && uci commit xray
	echo "$from" > $HD/sw_from; echo "$nn" > $HD/sw_to; echo "$now" > $HD/sw_ts; echo 0 > $HD/fails
	logger -t xray-sub "proxy probe failed 3 times in a row: switching node to $nn"
	/etc/init.d/xray restart >/dev/null 2>&1
}
health_check() {
	[ "$(cfg enabled)" = 1 ] || return 0
	if [ -z "$FORCE" ]; then m=$(date +%M); m=${m#0}; [ $(( ${m:-0} % 3 )) -eq 0 ] || return 0; fi
	mkdir -p $HD
	if probe_proxy "$PROBE_PORT"; then
		echo 0 > $HD/fails; echo ok > $HD/last; date +%s > $HD/ok_ts
	elif probe_wan; then
		f=$(cat $HD/fails 2>/dev/null || echo 0); f=$((f + 1)); echo $f > $HD/fails; echo fail > $HD/last
		logger -t xray-sub "proxy probe failed ($f)"
		# no switching while a chain exit is set (a bad exit would just rotate through every node)
		[ "$f" -ge 3 ] && [ "$(cfg auto_switch)" = 1 ] && [ -z "$(cfg chain)" ] && failover
	else
		echo wan-down > $HD/last
	fi
	date +%s > $HD/last_ts
}
fresh_ts() { date -r "$1" +%s 2>/dev/null || echo 0; }

case "$1" in
update)
	URL=$(cfg sub_url); [ -n "$URL" ] || { echo "xray.main.sub_url is not set"; exit 1; }
	wget -q -T 20 -U 'v2rayN/6.0' -O /tmp/sub.new "$URL" || { echo "download failed"; rm -f /tmp/sub.new; exit 1; }
	n=$( ( echo 1000 > /proc/self/oom_score_adj 2>/dev/null; exec /usr/bin/xr -sub /tmp/sub.new -list 2>/dev/null ) | wc -l)
	[ "$n" -ge 1 ] || { echo "no vless nodes found, keeping the old list"; rm -f /tmp/sub.new; exit 1; }
	mv /tmp/sub.new $D/sub.txt; chmod 600 $D/sub.txt; date +%s > /tmp/xray.subcheck; echo "$n nodes"
	# rebuild the cached list/statistics now, while nobody is waiting for the page
	rm -f "$LC" "$SC"; ensure_cache
	;;
auto-update)
	# cron runs this every hour; it only acts when the chosen interval (xray.main.sub_hours, default 24, 0 = never) has passed
	h=$(cfg sub_hours); h=${h:-24}
	[ "$h" -gt 0 ] 2>/dev/null || exit 0
	[ -n "$(cfg sub_url)" ] || exit 0
	now=$(date +%s); last=$(cat /tmp/xray.subcheck 2>/dev/null || echo 0)
	[ $((now - last)) -ge $((h * 3600 - 300)) ] || exit 0
	echo "$now" > /tmp/xray.subcheck
	wget -q -T 20 -U 'v2rayN/6.0' -O /tmp/sub.auto "$(cfg sub_url)" || { rm -f /tmp/sub.auto; logger -t xray-sub "subscription check: download failed"; exit 1; }
	# node names carry a latency that changes on every refresh, so compare the subscriptions without the names (#...).
	# The subscription is base64: decode it with ucode (a few hundred KB of RAM; an awk decoder used 6 MB and got killed once).
	# An empty answer means "could not read it": then nothing is replaced and nothing is restarted.
	fp() {
		d=$(ucode -e 'import { stdin } from "fs"; let s = stdin.read("all"); let r = b64dec(replace(s, /[ \r\n\t]/g, "")); if (r != null) print(r);' < "$1" 2>/dev/null)
		case "$d" in *://*) printf '%s\n' "$d" | sed 's/#.*$//' | md5sum | cut -d' ' -f1 ;; esac
	}
	f1=$(fp /tmp/sub.auto); f0=$(fp $D/sub.txt)
	if [ -z "$f1" ] || [ -z "$f0" ]; then rm -f /tmp/sub.auto; logger -t xray-sub "subscription check: could not compare, keeping the current list"; echo "cannot compare"; exit 1; fi
	if [ "$f1" = "$f0" ]; then rm -f /tmp/sub.auto; echo unchanged; exit 0; fi
	# reading the new list means starting xr (about 15 MB): not while memory is short, and as the first victim if it gets short anyway
	avail=$(free -k | awk 'NR==2{print $NF}')
	if [ "${avail:-0}" -lt 16000 ]; then rm -f /tmp/sub.auto /tmp/xray.subcheck; logger -t xray-sub "subscription check: not enough free memory (${avail} KB), will retry"; echo "low memory, retry later"; exit 1; fi
	n=$( ( echo 1000 > /proc/self/oom_score_adj 2>/dev/null; exec /usr/bin/xr -sub /tmp/sub.auto -list 2>/dev/null ) | wc -l)
	[ "$n" -ge 1 ] || { rm -f /tmp/sub.auto; logger -t xray-sub "subscription check: no vless nodes in the new list, keeping the old one"; exit 1; }
	mv /tmp/sub.auto $D/sub.txt; chmod 600 $D/sub.txt
	rm -f "$LC" "$SC"; ensure_cache
	logger -t xray-sub "subscription changed: $n nodes, restarting the proxy"
	[ "$(cfg enabled)" = 1 ] && /etc/init.d/xray restart >/dev/null 2>&1
	echo "changed $n nodes"
	;;
list)
	ensure_cache; cat "$LC" 2>/dev/null
	;;
health)
	echo "auto=$([ "$(cfg auto_switch)" = 1 ] && echo 1 || echo 0)"
	echo "chain=$([ -n "$(cfg chain)" ] && echo 1 || echo 0)"
	for k in last last_ts ok_ts fails sw_ts sw_from sw_to; do echo "$k=$(cat $HD/$k 2>/dev/null)"; done
	;;
probe)
	# xray-sub probe [port] : run the health check once, right now, and say what it found (no switching); [port] = test against another local port
	if probe_proxy "$2"; then echo "proxy ok"; elif probe_wan; then echo "proxy FAILED (the internet itself is reachable)"; else echo "no internet on the WAN side"; fi
	;;
pick-next)
	pick_next
	;;
switch-next)
	# xray-sub switch-next : move to the next node of the same source right now (what the automatic switch does)
	rm -f $HD/sw_ts; failover
	;;
exc-list)
	# "proxy|direct <TAB> entry", entries are addresses, blocks or domains
	for t in $(cfg proxy_ips) $(cfg proxy_domains); do echo "proxy$TAB$t"; done
	for t in $(cfg direct_ips) $(cfg direct_domains); do echo "direct$TAB$t"; done
	;;
exc-add)
	# xray-sub exc-add <proxy|direct> <ip|cidr|domain> : always send this destination through the proxy / always direct
	kind="$2"; tok=$(norm_domain "$3")
	case "$kind" in proxy) other=direct ;; direct) other=proxy ;; *) echo "bad kind"; exit 1 ;; esac
	if [ -n "$(ip_elems "$tok")" ]; then key=ips; elif is_domain "$tok"; then key=domains; else echo "不是域名或地址：$3"; exit 1; fi
	cur=$(cfg ${kind}_$key); newoth=""
	for x in $(cfg ${other}_$key); do [ "$x" = "$tok" ] || newoth="$newoth $x"; done
	case " $cur " in *" $tok "*) ;; *) cur="$cur $tok" ;; esac
	[ $(echo $cur | wc -w) -le 300 ] || { echo "too many entries"; exit 1; }
	uci set xray.main.${kind}_$key="$(echo $cur)"; uci set xray.main.${other}_$key="$(echo $newoth)"; uci commit xray
	[ -n "$(mainpid)" ] && { resolve_domains; exc_apply; }
	echo ok
	;;
exc-del)
	# xray-sub exc-del <ip|cidr|domain> : take the entry out of both lists
	tok=$(norm_domain "$2"); [ -n "$tok" ] || { echo "no entry"; exit 1; }
	for l in direct_ips proxy_ips direct_domains proxy_domains; do
		new=""; for x in $(cfg $l); do [ "$x" = "$tok" ] || new="$new $x"; done
		[ "$(echo $new)" = "$(cfg $l)" ] || uci set xray.main.$l="$(echo $new)"
	done
	uci commit xray
	[ -n "$(mainpid)" ] && { resolve_domains; exc_apply; }
	echo ok
	;;
exc-apply)
	# xray-sub exc-apply : load the current exception lists into the running rules now
	[ -n "$(mainpid)" ] && { resolve_domains; exc_apply; }
	echo ok
	;;
domains-refresh)
	# cron, every 5 minutes: keep the addresses of the listed domains up to date in the running rules
	[ -n "$(echo $(cfg direct_domains) $(cfg proxy_domains))" ] || exit 0
	[ -n "$(mainpid)" ] || exit 0
	resolve_domains; exc_apply
	;;
use-node)
	# xray-sub use-node "<exact node name>" : select that node (stored as a pattern that survives latency changes in the name)
	[ -n "$2" ] || { echo "no name"; exit 1; }
	uci set xray.main.node_name="^$(printf '%s' "$2" | esc_re | fuzzy_ms)\$" && uci commit xray && echo ok
	;;
stats)
	# what the subscription contains and what was left out
	ensure_cache; cat "$SC" 2>/dev/null
	;;
rules)
	case "$2" in
	on)
		[ -n "$(mainpid)" ] || { echo "xr is not running"; exit 1; }
		protect
		clients=$(cfg clients); port=$(cfg port)
		# clients = "all", "none", or a list of device MACs (aa:bb:..) and/or IPs, separated by spaces
		ips=""; macs=""
		for t in $clients; do
			case "$t" in
			all|none) ;;
			*:*) echo "$t" | grep -qiE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' && macs="$macs,$(echo $t | tr A-F a-f)" ;;
			*) echo "$t" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' && ips="$ips,$t" ;;
			esac
		done
		ips=${ips#,}; macs=${macs#,}
		CL=""; CL6=""
		if [ "$clients" = none ]; then
			CL="return"; CL6="return"
		elif [ -n "$ips" ] || [ -n "$macs" ]; then
			[ -n "$ips" ] && CL="ip saddr != { $ips }"
			[ -n "$macs" ] && CL="$CL ether saddr != { $macs }"
			CL="$CL return"; CL6="return"
		elif [ -n "$clients" ] && [ "$clients" != all ]; then
			# nothing in the list was understood: proxy nobody rather than everybody
			CL="return"; CL6="return"
		fi
		# user exceptions (xray.main.direct_ips / proxy_ips): IPv4 addresses or CIDR blocks, checked before the China list
		DE=""; PE=""
		sed -e "s/@PORT@/${port:-7892}/" -e "s#@CLIENT@#$CL#" -e "s#@CLIENT6@#$CL6#" -e "s#@DIRECT@#$DE#" -e "s#@PROXY@#$PE#" $D/xray.nft > /tmp/xray.rules.nft
		if nft -f /tmp/xray.rules.nft; then
			# block_quic defaults to on: the template already drops UDP 443. "0" removes that table.
			[ "$(cfg block_quic)" = 0 ] && nft delete table ip xrayudp 2>/dev/null
			echo "rules on (clients: ${clients:-all})"
			rm -f /tmp/xray.exc.proxy /tmp/xray.exc.direct; resolve_domains; exc_apply
		fi
		rm -f /tmp/xray.rules.nft
		;;
	off) rules_off; echo "rules off" ;;
	esac
	;;
watchdog)
	[ "$(cfg enabled)" = 1 ] || exit 0
	if [ -n "$(mainpid)" ]; then
		protect
		# Only look at ONE small chain: "nft list table" dumps the 5500-entry China IP set (6 MB of RAM, a lot of CPU),
		# and when memory is short that command gets killed - which used to make this check reload the whole ruleset every minute.
		if ! nft list chain ip xray pre >/dev/null 2>&1; then
			sleep 2
			nft list chain ip xray pre >/dev/null 2>&1 || "$0" rules on >/dev/null
		fi
		health_check
	else
		rules_off
	fi
	;;
restart)
	if [ "$(cfg enabled)" = 1 ]; then /etc/init.d/xray restart >/dev/null 2>&1; echo restarted; else echo "proxy is switched off"; fi
	;;
devices)
	# ip <TAB> name <TAB> mac <TAB> online(1/0): Wi-Fi association list + neighbour table + DHCP leases
	: > /tmp/xray.wifi
	for w in $(iwinfo 2>/dev/null | awk '/ESSID/ {print $1}'); do
		iwinfo $w assoclist 2>/dev/null | awk 'tolower($1) ~ /^[0-9a-f][0-9a-f]:/ {print tolower($1)}' >> /tmp/xray.wifi
	done
	ip -4 neigh show dev br-lan 2>/dev/null | awk '$2 == "lladdr" && $NF != "FAILED" && $NF != "INCOMPLETE" { print $1 "\t" tolower($3) "\t" $NF }' > /tmp/xray.neigh
	AL=$ALIAS; [ -f "$AL" ] || AL=/dev/null
	awk '
		FILENAME == ARGV[1] { wifi[$1] = 1; next }
		FILENAME == ARGV[2] { split($0, a, "\t"); nmac[a[1]] = a[2]; nst[a[1]] = a[3]; next }
		FILENAME == ARGV[3] { split($0, a, "\t"); al[a[1]] = a[2]; next }
		{
			ip = $3; mac = tolower($2); name = ($4 == "*" || $4 == "") ? "-" : $4; seen[ip] = 1
			if (mac in al) name = al[mac]
			on = (mac in wifi) || (ip in nst && nst[ip] ~ /REACHABLE|DELAY|PROBE|PERMANENT/)
			print ip "\t" name "\t" mac "\t" (on ? 1 : 0)
		}
		END {
			for (ip in nmac) if (!(ip in seen)) {
				on = (nmac[ip] in wifi) || (nst[ip] ~ /REACHABLE|DELAY|PROBE|PERMANENT/)
				print ip "\t" ((nmac[ip] in al) ? al[nmac[ip]] : "-") "\t" nmac[ip] "\t" (on ? 1 : 0)
			}
		}' /tmp/xray.wifi /tmp/xray.neigh "$AL" /tmp/dhcp.leases 2>/dev/null
	rm -f /tmp/xray.wifi /tmp/xray.neigh
	;;
get)
		for k in enabled node_name node clients sub_url port chain sub_hours auto_switch block_quic direct_ips proxy_ips direct_domains proxy_domains; do echo "$k=$(cfg $k)"; done
		echo "sub_check=$(cat /tmp/xray.subcheck 2>/dev/null)"; echo "sub_change=$(fresh_ts $D/sub.txt)"
	;;
set)
		case "$2" in enabled|node_name|node|clients|sub_url|port|chain|sub_hours|auto_switch|block_quic|direct_ips|proxy_ips|direct_domains|proxy_domains) ;; *) echo "bad key"; exit 1 ;; esac
		case "$2" in
		node_name) set -- "$1" "$2" "$(printf '%s' "$3" | fuzzy_ms)" ;;
		sub_hours) echo "$3" | grep -qE '^[0-9]{1,3}$' && [ "$3" -le 720 ] || { echo "bad value"; exit 1; } ;;
		direct_domains|proxy_domains)
			cnt=0; clean=""
			for t in $3; do
				t=$(norm_domain "$t"); is_domain "$t" || { echo "不是域名：$t（中文域名请在页面里添加，如 百度.com）"; exit 1; }
				cnt=$((cnt + 1)); clean="$clean $t"
			done
			[ $cnt -le 300 ] || { echo "too many entries (max 300)"; exit 1; }
			set -- "$1" "$2" "$(echo $clean)" ;;
		auto_switch|block_quic) case "$3" in 0|1) ;; *) echo "bad value"; exit 1 ;; esac ;;
		direct_ips|proxy_ips)
			# every item must be a valid IPv4 address or CIDR block; the stored value is the cleaned list
			cnt=0; for t in $3; do cnt=$((cnt + 1)); [ -n "$(ip_elems "$t")" ] || { echo "bad value: $t"; exit 1; }; done
			[ $cnt -le 300 ] || { echo "too many entries (max 300)"; exit 1; }
			set -- "$1" "$2" "$(echo $3)" ;;
		esac
	case "$3" in *"
"*) echo "bad value"; exit 1 ;; esac
	# a chain address is checked before it is stored: a bad one would stop the proxy from starting
	if [ "$2" = chain ] && [ -n "$3" ]; then
		err=$(/usr/bin/xr -check-chain "$3" 2>&1) || { echo "$err"; exit 1; }
	fi
	uci set "xray.main.$2=$3" && uci commit xray && echo ok
	[ "$2" = chain ] && [ -n "$3" ] && chain_remember "$3"
	;;
chain-history)
	# addresses saved before, newest first; clearing the current one does not remove them
	[ -n "$(cfg chain)" ] && chain_remember "$(cfg chain)"
	[ -s $CH ] && cat $CH
	;;
chain-forget)
	[ -n "$2" ] && [ -f $CH ] && { grep -vxF "$2" $CH > $CH.new; mv $CH.new $CH; }
	echo ok
	;;
chain-test-start)
	# xray-sub chain-test-start [address] : use the selected node as the front hop and report where traffic leaves
	[ -n "${2:-$(cfg chain)}" ] || { echo "no chain address set"; exit 1; }
	err=$(/usr/bin/xr -check-chain "${2:-$(cfg chain)}" 2>&1) || { echo "$err"; exit 1; }
	ps | grep -q '[x]ray-sub chain-test-run ' && { echo "already running"; exit 1; }
	avail=$(free -k | awk 'NR==2{print $NF}')
	[ "${avail:-0}" -ge 14000 ] || { echo "not enough free memory (${avail} KB, need 14000 KB); try again in a moment"; exit 1; }
	: > /tmp/chain-test.out
	start-stop-daemon -S -b -m -p /tmp/xray-chain-test.pid -x /usr/bin/xray-sub -O /tmp/chain-test.out -- chain-test-run "${2:-$(cfg chain)}" || { echo "failed to start test"; exit 1; }
	echo started
	;;
chain-test-run)
	TP=7893; url="$2"; name=$(cfg node_name); node=$(cfg node)
	ipapi=$(nslookup ip-api.com 127.0.0.1 2>/dev/null | sed -n '/^Name/,$p' | grep -oE '([0-9]{1,3}[.]){3}[0-9]{1,3}' | head -1)
	nft delete table ip xchain 2>/dev/null
	nft add table ip xchain
	nft add chain ip xchain out '{ type nat hook output priority -100 ; }'
	nft add rule ip xchain out ip daddr { 162.159.0.0/16, 104.16.0.0/12, 172.64.0.0/13, 141.101.64.0/18, 108.162.192.0/18, ${ipapi:-203.0.113.1} } tcp dport 80 redirect to :$TP
	if [ -n "$name" ]; then
		GOGC=50 GOMEMLIMIT=18MiB /usr/bin/xr -sub $D/sub.txt -name "$name" -port $TP -chain "$url" >/dev/null 2>&1 </dev/null &
	else
		GOGC=50 GOMEMLIMIT=18MiB /usr/bin/xr -sub $D/sub.txt -n "${node:-1}" -port $TP -chain "$url" >/dev/null 2>&1 </dev/null &
	fi
	P=$!; echo 1000 > /proc/$P/oom_score_adj 2>/dev/null; w=0
	while [ $w -lt 10 ] && ! netstat -ltn 2>/dev/null | grep -q ":$TP "; do sleep 1; w=$((w+1)); done
	for what in trace info; do
		rm -f /tmp/chain.dl
		if [ $what = trace ]; then u="http://speed.cloudflare.com/cdn-cgi/trace"; else u="http://ip-api.com/json/?fields=status,country,regionName,city,isp,org,hosting,mobile,proxy,query"; fi
		wget -4 -qO /tmp/chain.dl -T 12 "$u" >/dev/null 2>&1 </dev/null &
		WP=$!; ( sleep 18; kill -9 $WP 2>/dev/null ) >/dev/null 2>&1 &
		KP=$!; wait $WP 2>/dev/null; kill $KP 2>/dev/null
		if [ $what = trace ]; then echo "trace=$(grep -E '^(loc|colo)=' /tmp/chain.dl 2>/dev/null | tr '\n' ' ')"; else echo "info=$(cat /tmp/chain.dl 2>/dev/null | tr -d '\n')"; fi
	done
	alive=0; kill -0 $P 2>/dev/null && alive=1
	[ $alive = 1 ] || echo "error=the test process was killed for lack of memory, try again in a moment"
	kill -9 $P 2>/dev/null; wait $P 2>/dev/null
	nft delete table ip xchain 2>/dev/null; rm -f /tmp/chain.dl
	echo done=1
	;;
chain-test-state)
	if ps | grep -q '[x]ray-sub chain-test-run '; then echo running; else echo idle; fi
	cat /tmp/chain-test.out 2>/dev/null
	;;
apply)
	if [ "$(cfg enabled)" = 1 ]; then /etc/init.d/xray restart; else /etc/init.d/xray stop; fi
	echo applied
	;;
status)
	echo "enabled : $(cfg enabled)   node: $(cfg node_name)/$(cfg node)   clients: $(cfg clients)"
	echo "health  : $(cat $HD/last 2>/dev/null || echo unknown) fails=$(cat $HD/fails 2>/dev/null || echo 0)"
	echo "proxied : $(cat /tmp/netmon/flow.px 2>/dev/null || echo '0 0')"
	# the chain address holds credentials: show only scheme://host:port
	ch=$(cfg chain)
	if [ -z "$ch" ]; then echo "chain   : none"
	else case "$ch" in *@*) echo "chain   : ${ch%%://*}://$(echo "${ch##*@}" | cut -d'?' -f1 | cut -d'#' -f1 | cut -d/ -f1)" ;; *) echo "chain   : ${ch%%://*}://(hidden)" ;; esac; fi
	MP=$(mainpid); if [ -n "$MP" ]; then echo "xr      : running, $(grep VmRSS /proc/$MP/status | tr -s '	 ' ' ' | cut -d' ' -f2) kB RSS"; else echo "xr      : stopped"; fi
	nft list chain ip xray pre >/dev/null 2>&1 && echo "rules   : on" || echo "rules   : off"
	ensure_cache; echo "sub     : $(wc -l < "$LC" 2>/dev/null || echo 0) nodes"
	;;
*)
	echo "usage: xray-sub update | auto-update | list | exc-list | exc-add <proxy|direct> <x> | exc-del <x> | exc-apply | domains-refresh | get | set K V | apply | rules on|off | health | probe | pick-next | switch-next | chain-test-start | chain-history | chain-forget | status | watchdog"
	;;
esac
