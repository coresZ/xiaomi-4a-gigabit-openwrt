#!/bin/sh /etc/rc.common
USE_PROCD=1
START=95
STOP=10

start_service() {
	[ "$(uci -q get xray.main.enabled)" = 1 ] || return 0
	[ -s /etc/xray/sub.txt ] || /usr/bin/xray-sub update
	[ -s /etc/xray/sub.txt ] || return 1
	local port node name chain
	port=$(uci -q get xray.main.port); node=$(uci -q get xray.main.node); name=$(uci -q get xray.main.node_name)
	chain=$(uci -q get xray.main.chain)
	procd_open_instance
	if [ -n "$name" ]; then
		procd_set_param command /usr/bin/xr -sub /etc/xray/sub.txt -name "$name" -port "${port:-7892}"
	else
		procd_set_param command /usr/bin/xr -sub /etc/xray/sub.txt -n "${node:-1}" -port "${port:-7892}"
	fi
	# optional chain: the selected node is the front hop, this proxy is the exit (e.g. a residential socks5)
	[ -n "$chain" ] && procd_append_param command -chain "$chain"
	procd_set_param respawn 3600 5 5
	procd_set_param env GOGC=50 GOMEMLIMIT=24MiB
	procd_set_param stderr 1
	procd_close_instance
	( sleep 3; /usr/bin/xray-sub rules on ) >/dev/null 2>&1 &
	# warm the node-list cache a little later, once the proxy is settled and before anyone opens the page
	( sleep 45; /usr/bin/xray-sub list ) >/dev/null 2>&1 &
}

stop_service() {
	/usr/bin/xray-sub rules off >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger xray
}
